# Server-only runtime configuration. Keep real values out of source control.
# Database: production uses the Cloudflare D1 binding named DB; no DATABASE_URL is read.

# Synthetic session and graph signing
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
GRAPH_HMAC_SECRET=replace-with-a-separate-long-random-secret

# Optional Sarvam speech, translation, and extraction providers
SARVAM_API_KEY=
SARVAM_ASR_MODEL=saaras:v3
SARVAM_TRANSLATION_MODEL=sarvam-translate:v1
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=kavya
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_VOICE_AGENT_ID=
SARVAM_VOICE_AGENT_VERSION=2

# Optional OpenAI preparation, support, and vision providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_SUPPORT_MODEL=gpt-5.6-terra
OPENAI_VISION_MODEL=gpt-4o-2024-08-06
