# CyberSaarthi - environment template
#
# Copy to .env.local for local development:  cp .env.example .env.local
# Real values must never be committed. .gitignore blocks every .env* file except
# this template.
#
# There is deliberately no DATABASE_URL. The application reads Cloudflare D1
# through the Worker binding named DB, so no database connection string exists
# in configuration, environment or source.

# ---------------------------------------------------------------------------
# Required: cryptographic secrets
# ---------------------------------------------------------------------------
# Two DIFFERENT long random values. Generate one with:
#   node -e "console.log(crypto.randomUUID().replace(/-/g,'') + crypto.randomUUID().replace(/-/g,''))"
# AUTH_SESSION_SECRET signs the session cookie.
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
# Fixed synthetic accounts are disabled in production unless explicitly enabled.
# Keep false for any environment that could hold real personal data.
DEMO_ACCESS_ENABLED=false
# GRAPH_HMAC_SECRET keys the HMAC fingerprints used for cross-case identifier
# correlation. Rotating it invalidates existing graph fingerprints.
GRAPH_HMAC_SECRET=replace-with-a-separate-long-random-secret

# ---------------------------------------------------------------------------
# Optional: Sarvam AI (speech, translation, TTS, voice agent)
# Leave blank to fall back to deterministic fixture paths.
# ---------------------------------------------------------------------------
SARVAM_API_KEY=
SARVAM_ASR_MODEL=saaras:v3
SARVAM_TRANSLATION_MODEL=sarvam-translate:v1
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=kavya
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_VOICE_AGENT_ID=
SARVAM_VOICE_AGENT_VERSION=2

# ---------------------------------------------------------------------------
# Optional: OpenAI (field preparation, support, vision)
# Leave blank to fall back to deterministic fixture paths.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_SUPPORT_MODEL=gpt-5.6-terra
OPENAI_VISION_MODEL=gpt-4o-2024-08-06

# ---------------------------------------------------------------------------
# Retention maintenance
# ---------------------------------------------------------------------------
# Required for the daily Vercel Cron endpoint. Generate a separate random secret.
CRON_SECRET=replace-with-a-long-random-secret
